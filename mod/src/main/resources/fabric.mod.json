{
  "schemaVersion": 1,
  "id": "emberlight",
  "version": "${version}",
  "name": "Emberlight",
  "description": "Runs OptiFine/Iris shaderpacks on Minecraft's Vulkan renderer. Uses NVIDIA DLSS. NVIDIA, NVIDIA RTX and DLSS are trademarks of NVIDIA Corporation; the bundled DLSS bridge is under LICENSE-DLSS.txt, not the LGPL.",
  "license": ["LGPL-3.0-only", "LicenseRef-Emberlight-DLSS"],
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.emrion.shaders.mod.EmrionShadersClient"
    ],
    "preLaunch": [
      "dev.emrion.shaders.mod.compat.IrisApiShim"
    ]
  },
  "mixins": [
    "emrionshaders.mixins.json",
    "emrionshaders.iris.mixins.json",
    "emrionshaders.sodium.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.20.1",
    "minecraft": "~26.3",
    "fabric-api": "*",
    "sodium": ">=0.9.3-beta.5"
  },
  "breaks": {
    "sodium": ">0.9.3-beta.5"
  },
  "icon": "assets/emberlight/icon.png",
  "custom": {
    "sodium:options": {
      "mixin.features.render.world.sky": false
    }
  }
}
